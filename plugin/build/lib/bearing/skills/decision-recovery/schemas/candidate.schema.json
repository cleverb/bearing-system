{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision Recovery Candidate",
  "type": "object",
  "required": [
    "candidate_id", "subject", "candidate_relation", "candidate_object",
    "candidate_eocr_function", "evidence", "confidence", "lifecycle_state",
    "idempotency_key"
  ],
  "properties": {
    "candidate_id": { "type": "string" },
    "subject": { "type": "string", "description": "Code symbol, file, or component this candidate concerns" },
    "candidate_relation": { "type": "string", "description": "e.g. governed_by, exists_because, must_not_use, migration_procedure" },
    "candidate_object": { "type": "string" },
    "candidate_eocr_function": {
      "type": "string",
      "enum": ["Entry", "Operations", "Contract", "Rationale"]
    },
    "temporal_scope": { "type": "string", "description": "Date range or applicability window for this evidence" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "evidence.schema.json" }
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"]
    },
    "confidence_breakdown_available": { "type": "boolean" },
    "lifecycle_state": {
      "type": "string",
      "enum": ["Detected", "Corroborated", "Reviewable", "Promoted", "Rejected", "Insufficient Evidence", "Stale"]
    },
    "idempotency_key": {
      "type": "string",
      "description": "symbol + source-corpus-version + extractor-version"
    }
  }
}
