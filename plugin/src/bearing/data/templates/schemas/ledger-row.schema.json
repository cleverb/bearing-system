{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["run_id", "stage"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "condition": { "type": "string" },
    "model": { "type": "string" },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "token_source": { "enum": ["measured", "estimated"] },
    "estimated_review_minutes": { "type": "number", "minimum": 0 },
    "interview_duration_minutes": { "type": "number", "minimum": 0 },
    "candidates_reviewed": { "type": "integer", "minimum": 0 },
    "candidates_promoted": { "type": "integer", "minimum": 0 },
    "rework_count": { "type": "integer", "minimum": 0 },
    "contract_violations": { "type": "integer", "minimum": 0 },
    "escalation_correct": { "type": "integer", "minimum": 0 },
    "minutes_to_first_anchor": { "type": "integer", "minimum": 0 }
  }
}
